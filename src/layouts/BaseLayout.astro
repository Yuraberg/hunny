---
import { getCollection } from 'astro:content';
import Nav from '../components/Nav.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import CartFab from '../components/CartFab.astro';
import CartModal from '../components/CartModal.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article' | 'product';
}

const { title, description, image, noindex = false, ogType = 'website' } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://medovayasloboda.ru';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = new URL(image ?? '/img/logo-badge.webp', siteUrl).toString();

const products = await getCollection('products', (p) => import.meta.env.DEV || !p.data.draft);

// Счётчик и подтверждение прав задаются секретами на этапе сборки (deploy.yml) —
// до их заполнения просто не рендерятся, сборка не ломается.
const yandexMetrikaId = import.meta.env.YANDEX_METRIKA_ID;
const googleSiteVerification = import.meta.env.GOOGLE_SITE_VERIFICATION;
const yandexSiteVerification = import.meta.env.YANDEX_SITE_VERIFICATION;
const productsData = products.map((p) => ({ id: p.id, name: p.data.name, price: p.data.price }));

// Организация и сайт — общие для всех страниц, помогают Яндексу и Google
// показать карточку компании в выдаче (Store) и sitelinks search box (WebSite).
const businessSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Store',
      '@id': `${siteUrl}/#business`,
      name: 'Медовая Слобода',
      description: 'Семейная пасека Дмитрия Бердникова в Самарском крае. Натуральный мёд без добавок: цветочный, гречишный, липовый, а также подарочные наборы.',
      url: `${siteUrl}/`,
      image: `${siteUrl}/img/logo-badge.webp`,
      telephone: '+7-933-535-55-39',
      email: 'info@medovayasloboda.ru',
      priceRange: '500–2500 ₽',
      currenciesAccepted: 'RUB',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Самара',
        addressRegion: 'Самарская область',
        addressCountry: 'RU',
      },
      areaServed: { '@type': 'Country', name: 'Россия' },
      founder: { '@type': 'Person', name: 'Дмитрий Бердников' },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: 'Медовая Слобода',
      inLanguage: 'ru-RU',
      publisher: { '@id': `${siteUrl}/#business` },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
  <link rel="canonical" href={canonical} />

  {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
  {yandexSiteVerification && <meta name="yandex-verification" content={yandexSiteVerification} />}

  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Медовая Слобода" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="ru_RU" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
  <slot name="structured-data" />

  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath d='M16 2 L28 9 L28 23 L16 30 L4 23 L4 9 Z' fill='%23C8922A'/%3E%3Cpath d='M16 7 L23.5 11.5 L23.5 20.5 L16 25 L8.5 20.5 L8.5 11.5 Z' fill='%233D2B1A'/%3E%3C/svg%3E" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />

  {yandexMetrikaId && (
    <script define:vars={{ metrikaId: Number(yandexMetrikaId) }}>
      (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
      m[i].l=1*new Date();
      for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
      k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
      (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");

      ym(metrikaId, "init", {
        clickmap: true,
        trackLinks: true,
        accurateTrackBounce: true,
        webvisor: true
      });
    </script>
    <noscript>
      <div><img src={`https://mc.yandex.ru/watch/${yandexMetrikaId}`} style="position:absolute; left:-9999px;" alt="" /></div>
    </noscript>
  )}
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Alegreya:ital,wght@0,400;0,500;0,700;1,400&family=Alegreya+SC:wght@400;700&family=Ruslan+Display&display=swap" rel="stylesheet" />
</head>
<body>
  <script type="application/json" id="products-data" is:inline set:html={JSON.stringify(productsData)} />

  <Nav />
  <MobileMenu />
  <slot />
  <Footer />
  <Lightbox />
  <CartFab />
  <CartModal />

  <script>
    const reveals = document.querySelectorAll('.reveal');
    const showAll = () => reveals.forEach((el) => el.classList.add('visible'));

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) entry.target.classList.add('visible');
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -50px 0px' }
      );
      reveals.forEach((el) => observer.observe(el));

      setTimeout(() => {
        if (document.querySelectorAll('.reveal.visible').length === 0) showAll();
      }, 2500);
    } else {
      showAll();
    }
  </script>
</body>
</html>
