---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const stories = await getCollection('stories', (s) => import.meta.env.DEV || !s.data.draft);
  return stories.map((story) => ({ params: { slug: story.id }, props: { story } }));
}

const { story } = Astro.props;
const { title, excerpt, heroImage, tags, publishedDate, author } = story.data;
const { Content } = await render(story);
const dateLabel = publishedDate.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={`${title} — Медовая Слобода`} description={excerpt}>
  <article class="texture-paper px-5 py-24 md:py-28">
    <div class="mx-auto max-w-2xl">
      <a href="/stories" class="mb-6 inline-block text-honey-amber hover:underline">← Все истории</a>

      <div class="mb-8 aspect-[16/10] w-full overflow-hidden rounded-2xl shadow-[0_10px_34px_var(--shadow-deep)]">
        <Image src={heroImage} alt={title} width={800} height={500} class="h-full w-full object-cover" />
      </div>

      {tags.length > 0 && (
        <div class="mb-3 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="font-label rounded-full bg-cream px-3 py-1 text-xs text-honey-amber">{tag}</span>
          ))}
        </div>
      )}

      <h1 class="font-display mb-2 text-3xl text-bark">{title}</h1>
      <p class="mb-8 text-sm text-text-body/60">{author} · {dateLabel}</p>

      <div class="story-content text-text-body">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
