---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('wiki', (a) => import.meta.env.DEV || !a.data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://medovayasloboda.ru';

const title = article.data.title;
const description = article.data.excerpt;
const category = article.data.category;
const { Content } = await render(article);

const pageUrl = `${siteUrl}${Astro.url.pathname}`;
const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: title,
      description,
      inLanguage: 'ru-RU',
      mainEntityOfPage: pageUrl,
      isPartOf: { '@id': `${siteUrl}/#website` },
      publisher: { '@id': `${siteUrl}/#business` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Медовая энциклопедия', item: `${siteUrl}/wiki` },
        { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
      ],
    },
  ],
};
---

<BaseLayout title={`${title} — Медовая энциклопедия`} description={description} ogType="article">
  <script slot="structured-data" is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <article class="texture-paper px-5 py-24 md:py-28">
    <div class="mx-auto max-w-2xl">
      <a href="/wiki" class="mb-6 block text-honey-amber hover:underline">← Вся энциклопедия</a>

      {category && (
        <span class="font-label mb-3 inline-block rounded-full bg-cream px-3 py-1 text-xs text-honey-amber">
          {category}
        </span>
      )}

      <h1 class="font-display mb-8 text-3xl text-bark">{title}</h1>

      <div class="mb-8 rounded-xl border border-honey-gold/40 bg-kraft/40 p-4 text-sm text-text-body">
        Материал носит справочный характер и не является медицинской рекомендацией.
        Перед применением мёда и продуктов пчеловодства в лечебных целях проконсультируйтесь с врачом.
      </div>

      <div class="wiki-content text-text-body">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
