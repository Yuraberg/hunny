---
import type { CompareItem } from '../../data/comparisons';

interface Props {
  title: string;
  subtitle: string;
  items: CompareItem[];
  kind: 'hive' | 'caste';
}

const { title, subtitle, items, kind } = Astro.props;

// Маленькие силуэты-иконки для карточек — держим их здесь, а не в data/,
// чтобы данные сравнения оставались чистым контентом без разметки.
const hiveIcons: Record<string, string> = {
  'uley-dadana-blatta': `<svg viewBox="0 0 40 40" width="40" height="40"><rect x="10" y="4" width="20" height="12" rx="1" fill="var(--color-honey-gold)" stroke="var(--color-bark)" stroke-width="2"/><rect x="6" y="18" width="28" height="18" rx="1" fill="var(--color-kraft-dark)" stroke="var(--color-bark)" stroke-width="2"/></svg>`,
  'uley-langstrota': `<svg viewBox="0 0 40 40" width="40" height="40"><rect x="10" y="6" width="20" height="10" rx="1" fill="var(--color-honey-gold)" stroke="var(--color-bark)" stroke-width="2"/><rect x="8" y="18" width="24" height="18" rx="1" fill="var(--color-kraft-dark)" stroke="var(--color-bark)" stroke-width="2"/></svg>`,
  'uley-lezhak': `<svg viewBox="0 0 40 40" width="40" height="40"><rect x="2" y="16" width="36" height="18" rx="1" fill="var(--color-kraft-dark)" stroke="var(--color-bark)" stroke-width="2"/><line x1="12" y1="16" x2="12" y2="34" stroke="var(--color-bark)" stroke-width="1.5" opacity="0.5"/><line x1="20" y1="16" x2="20" y2="34" stroke="var(--color-bark)" stroke-width="1.5" opacity="0.5"/><line x1="28" y1="16" x2="28" y2="34" stroke="var(--color-bark)" stroke-width="1.5" opacity="0.5"/></svg>`,
  'mnogokorpusnyy-uley': `<svg viewBox="0 0 40 40" width="40" height="40"><rect x="8" y="2" width="24" height="8" rx="1" fill="var(--color-honey-gold)" stroke="var(--color-bark)" stroke-width="1.5"/><rect x="8" y="12" width="24" height="8" rx="1" fill="var(--color-kraft-dark)" stroke="var(--color-bark)" stroke-width="1.5"/><rect x="8" y="22" width="24" height="8" rx="1" fill="var(--color-honey-gold)" stroke="var(--color-bark)" stroke-width="1.5"/><rect x="8" y="32" width="24" height="6" rx="1" fill="var(--color-kraft-dark)" stroke="var(--color-bark)" stroke-width="1.5"/></svg>`,
};

const casteIcons: Record<string, string> = {
  'matka-pchelinaya': `<svg viewBox="0 0 40 40" width="40" height="40"><ellipse cx="20" cy="22" rx="10" ry="15" fill="var(--color-honey-gold)" stroke="var(--color-bark)" stroke-width="2"/><circle cx="20" cy="7" r="6" fill="var(--color-bark-light)" stroke="var(--color-bark)" stroke-width="2"/></svg>`,
  'rabochaya-pchela': `<svg viewBox="0 0 40 40" width="40" height="40"><ellipse cx="20" cy="24" rx="8" ry="10" fill="var(--color-honey-gold)" stroke="var(--color-bark)" stroke-width="2"/><circle cx="20" cy="11" r="6" fill="var(--color-bark-light)" stroke="var(--color-bark)" stroke-width="2"/></svg>`,
  truten: `<svg viewBox="0 0 40 40" width="40" height="40"><ellipse cx="20" cy="23" rx="11" ry="11" fill="var(--color-honey-gold)" stroke="var(--color-bark)" stroke-width="2"/><circle cx="20" cy="9" r="7" fill="var(--color-bark-light)" stroke="var(--color-bark)" stroke-width="2"/></svg>`,
};

const icons = kind === 'hive' ? hiveIcons : casteIcons;
---

<div class="reveal mx-auto mt-24 max-w-5xl">
  <div class="title-ornate">
    <h2 class="font-display text-2xl text-bark">{title}</h2>
  </div>
  <p class="font-accent mb-10 text-center text-honey-amber italic">{subtitle}</p>

  <div class:list={['grid gap-5', kind === 'hive' ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-3']}>
    {items.map((item) => (
      <a
        href={`/wiki/${item.slug}`}
        class="compare-card group flex flex-col rounded-2xl bg-warm-white p-5 shadow-[0_2px_10px_var(--shadow)] transition-transform hover:-translate-y-1"
      >
        <div class="mb-4 flex h-14 items-end justify-center" set:html={icons[item.slug] ?? ''} />
        <h3 class="font-label mb-1 text-center text-base text-bark group-hover:text-honey-amber">{item.title}</h3>
        <p class="font-accent mb-4 text-center text-sm text-honey-amber italic">{item.tagline}</p>
        <ul class="flex flex-1 flex-col gap-2 text-sm text-text-body">
          {item.facts.map((fact) => (
            <li class="flex gap-2">
              <span class="mt-0.5 text-honey-gold">◆</span>
              <span>{fact}</span>
            </li>
          ))}
        </ul>
        <span class="font-label mt-4 inline-block text-center text-xs text-honey-amber group-hover:underline">Подробнее →</span>
      </a>
    ))}
  </div>
</div>
