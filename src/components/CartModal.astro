<div id="cartOverlay" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
  <div
    id="cartModal"
    class="flex max-h-[85vh] w-full max-w-md flex-col rounded-2xl bg-warm-white shadow-2xl"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cartModalTitle"
  >
    <div class="flex items-center justify-between border-b border-cream-dark p-5">
      <h3 id="cartModalTitle" class="font-display text-xl text-bark">Ваша корзина</h3>
      <button id="cartModalClose" class="flex h-11 w-11 items-center justify-center rounded-full hover:bg-cream" aria-label="Закрыть корзину">✕</button>
    </div>
    <div id="cartModalBody" class="flex-1 overflow-y-auto p-5"></div>
    <div id="cartModalFooter" class="border-t border-cream-dark p-5"></div>
  </div>
</div>

<script>
  import {
    getCart,
    getProduct,
    changeQty,
    removeFromCart,
    clearCart,
    cartTotal,
    cartDiscount,
    isFreeShipping,
    FREE_SHIPPING_THRESHOLD,
    linePricing,
  } from '../lib/cart';

  const overlay = document.getElementById('cartOverlay');
  const body = document.getElementById('cartModalBody');
  const footer = document.getElementById('cartModalFooter');

  function escapeHtml(str: string) {
    return str.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  }

  function pluralJars(n: number) {
    const mod10 = n % 10;
    const mod100 = n % 100;
    if (mod10 === 1 && mod100 !== 11) return 'банка';
    if (mod10 >= 2 && mod10 <= 4 && (mod100 < 10 || mod100 >= 20)) return 'банки';
    return 'банок';
  }

  function render() {
    const cart = getCart();
    if (!body || !footer) return;

    if (cart.length === 0) {
      body.innerHTML = `<div class="text-center py-10">
        <p class="mb-4 text-text-body">Корзина пуста — загляните в каталог 🍯</p>
        <a href="/#catalog" class="font-label inline-block rounded-full bg-bark px-6 py-3 text-cream" id="cartGoCatalog">В каталог</a>
      </div>`;
      footer.innerHTML = '';
      document.getElementById('cartGoCatalog')?.addEventListener('click', close);
      return;
    }

    body.innerHTML = cart
      .map((item) => {
        const p = getProduct(item.id);
        if (!p) return '';
        const { price, percent, freeUnits } = linePricing(p.price, item.qty);
        const priceLine =
          percent > 0
            ? `<span class="text-text-body/40 line-through">${(p.price * item.qty).toLocaleString('ru-RU')} ₽</span> <span class="text-forest-dark">${price.toLocaleString('ru-RU')} ₽</span> <span class="text-forest-dark">(−${percent}%)</span>`
            : `<span>${price.toLocaleString('ru-RU')} ₽</span>`;
        const freeNote =
          freeUnits > 0 ? `+${freeUnits} ${pluralJars(freeUnits)} в подарок 🎁` : '';
        return `<div class="border-b border-cream-dark py-3">
          <div class="flex items-center justify-between gap-3">
            <div>
              <div class="font-label text-bark">${escapeHtml(p.name)}</div>
              <div class="text-base text-honey-amber">${p.price.toLocaleString('ru-RU')} ₽ / шт.</div>
            </div>
            <div class="flex items-center gap-1">
              <button type="button" class="qty-btn flex h-11 w-11 items-center justify-center rounded-full border border-cream-dark" data-id="${item.id}" data-delta="-1" aria-label="Уменьшить количество">−</button>
              <span class="min-w-[20px] text-center">${item.qty}</span>
              <button type="button" class="qty-btn flex h-11 w-11 items-center justify-center rounded-full border border-cream-dark" data-id="${item.id}" data-delta="1" aria-label="Увеличить количество">+</button>
            </div>
            <button type="button" class="remove-btn flex h-11 w-11 shrink-0 items-center justify-center text-text-body/60 hover:text-text-body" data-id="${item.id}" aria-label="Убрать из корзины">✕</button>
          </div>
          <div class="mt-1 flex items-center justify-between text-base">
            <span class="text-forest-dark">${freeNote}</span>
            <span>${priceLine}</span>
          </div>
        </div>`;
      })
      .join('');

    const discount = cartDiscount();
    const total = cartTotal();
    const freeShipping = isFreeShipping(total);
    const remaining = FREE_SHIPPING_THRESHOLD - total;

    footer.innerHTML = `
      ${
        discount > 0
          ? `<div class="mb-1 flex items-center justify-between text-base text-text-body/70">
               <span>Скидка за количество</span><span class="text-forest-dark">−${discount.toLocaleString('ru-RU')} ₽</span>
             </div>`
          : ''
      }
      <div class="mb-1 flex items-center justify-between">
        <span>Итого:</span>
        <strong class="text-xl text-honey-amber">${total.toLocaleString('ru-RU')} ₽</strong>
      </div>
      <div class="mb-4 text-sm ${freeShipping ? 'text-forest-dark' : 'text-text-body/60'}">
        ${
          freeShipping
            ? '✓ Бесплатная доставка — заказ от ' + FREE_SHIPPING_THRESHOLD.toLocaleString('ru-RU') + ' ₽'
            : 'Ещё ' + remaining.toLocaleString('ru-RU') + ' ₽ до бесплатной доставки'
        }
      </div>
      <a href="/#order" class="font-label block rounded-full bg-bark px-6 py-3 text-center text-cream" id="cartCheckout">Оформить заказ</a>
      <button type="button" class="mt-3 w-full text-center text-sm text-text-body/60 hover:text-text-body" id="cartClear">Очистить корзину</button>
    `;

    body.querySelectorAll<HTMLButtonElement>('.qty-btn').forEach((btn) =>
      btn.addEventListener('click', () => changeQty(btn.dataset.id!, Number(btn.dataset.delta)))
    );
    body.querySelectorAll<HTMLButtonElement>('.remove-btn').forEach((btn) =>
      btn.addEventListener('click', () => removeFromCart(btn.dataset.id!))
    );
    document.getElementById('cartCheckout')?.addEventListener('click', close);
    document.getElementById('cartClear')?.addEventListener('click', clearCart);
  }

  const modal = document.getElementById('cartModal');
  let lastFocused: HTMLElement | null = null;

  function focusableEls(): HTMLElement[] {
    if (!modal) return [];
    return Array.from(
      modal.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'
      )
    );
  }

  function open() {
    lastFocused = document.activeElement as HTMLElement | null;
    overlay?.classList.remove('hidden');
    overlay?.classList.add('flex');
    document.body.style.overflow = 'hidden';
    (document.getElementById('cartModalClose') as HTMLElement | null)?.focus();
  }

  function close() {
    overlay?.classList.add('hidden');
    overlay?.classList.remove('flex');
    document.body.style.overflow = '';
    lastFocused?.focus();
    lastFocused = null;
  }

  document.addEventListener('cart:open', open);
  document.getElementById('cartModalClose')?.addEventListener('click', close);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) close();
  });
  document.addEventListener('keydown', (e) => {
    if (overlay?.classList.contains('hidden')) return;
    if (e.key === 'Escape') {
      close();
      return;
    }
    if (e.key !== 'Tab') return;
    const els = focusableEls();
    if (els.length === 0) return;
    const first = els[0];
    const last = els[els.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  document.addEventListener('cart:change', render as EventListener);
  render();
</script>
