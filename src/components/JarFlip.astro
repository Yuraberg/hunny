---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  category: string;
  imageFront: ImageMetadata;
  imageBack?: ImageMetadata;
  size?: 'hero' | 'catalog';
  priority?: boolean;
}

const { name, category, imageFront, imageBack, size = 'catalog', priority = false } = Astro.props;

const sizeClasses =
  size === 'hero'
    ? 'w-[150px] h-[190px] sm:w-[190px] sm:h-[230px]'
    : 'w-full aspect-[4/5]';
---

<div class={`arch-frame relative ${sizeClasses}`}>
  <div
    class="jar-flip h-full w-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-honey-gold"
    tabindex="0"
    role="button"
    aria-pressed="false"
    aria-label={`Баночка «${name}»: показать оборот этикетки`}
  >
    <div class="jar-flip-inner">
      <div class="jar-flip-front">
        <Image
          src={imageFront}
          alt={`Банка мёда «${name}» — ${category}`}
          width={400}
          height={480}
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
        />
      </div>
      {imageBack && (
        <div class="jar-flip-back">
          <Image
            src={imageBack}
            alt={`Оборот этикетки «${name}» с описанием`}
            width={400}
            height={480}
            loading="lazy"
          />
        </div>
      )}
    </div>
  </div>
  <span
    class="pointer-events-none absolute top-2 right-2 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-warm-white/90 shadow"
    aria-hidden="true"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8" /><path d="M21 3v5h-5" /></svg>
  </span>
  {imageBack && (
    <button
      type="button"
      class="zoom-badge absolute top-2 left-2 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-warm-white/90 shadow"
      aria-label={`Увеличить фото «${name}»`}
      data-full={imageFront.src}
      data-alt={`Банка мёда «${name}» — ${category}`}
      data-full-back={imageBack.src}
      data-alt-back={`Оборот этикетки «${name}»`}
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
    </button>
  )}
</div>
