# Postgres, куда пишутся заказы (см. db/schema.sql)
DATABASE_URL=postgres://user:password@localhost:5432/medovaya_sloboda

# Личный кабинет ЮKassa → Настройки → API-ключи
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Личный кабинет Яндекс Доставки → тарификация
YANDEX_DELIVERY_API_KEY=

# Домен сайта — используется как return_url для ЮKassa
SITE_ORIGIN=https://medovayasloboda.ru

PORT=3000
